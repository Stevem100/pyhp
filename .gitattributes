# keep Windows shell scripts CRLF
*.bat text eol=crlf
*.ps1 text eol=crlf
# everything else textual: LF everywhere (including Windows checkouts),
# so the test suite's expected-output blocks stay byte-stable on all OSes
*.md   text eol=lf
*.php  text eol=lf
*.pyh  text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.yml  text eol=lf
*.txt  text eol=lf
*.cpp  text eol=lf
LICENSE text eol=lf
