// ai — machine-learning toolkit for PyHP.
// Pure, deterministic functions only: no globals, no I/O, seeded randomness.
// Works identically on all three engines (interpreter, PHP build, native build).

// ---------- linear algebra ----------

// dot product of two equal-length numeric lists
function dot(a, b) {
    if len(a) != len(b) {
        throw ValueError("dot(): lists must have the same length, got " + str(len(a)) + " and " + str(len(b)));
    }
    s = 0.0;
    for (i = 0; i < len(a); i++) {
        s += a[i] * b[i];
    }
    return s;
}

function euclid(a, b) {
    if len(a) != len(b) {
        throw ValueError("euclid(): lists must have the same length");
    }
    s = 0.0;
    for (i = 0; i < len(a); i++) {
        d = a[i] - b[i];
        s += d * d;
    }
    return sqrt(s);
}

function manhattan(a, b) {
    s = 0.0;
    for (i = 0; i < len(a); i++) {
        s += abs(a[i] - b[i]);
    }
    return s;
}

// cosine similarity in [-1, 1]
function cosine(a, b) {
    na = sqrt(dot(a, a));
    nb = sqrt(dot(b, b));
    if na == 0 || nb == 0 {
        return 0.0;
    }
    return dot(a, b) / (na * nb);
}

function transpose(A) {
    out = [];
    if len(A) == 0 {
        return out;
    }
    for (j = 0; j < len(A[0]); j++) {
        row = [];
        for (i = 0; i < len(A); i++) {
            row.append(A[i][j]);
        }
        out.append(row);
    }
    return out;
}

function matmul(A, B) {
    if len(A[0]) != len(B) {
        throw ValueError("matmul(): inner dimensions must match, got " + str(len(A[0])) + " and " + str(len(B)));
    }
    Bt = transpose(B);
    out = [];
    foreach row in A {
        r = [];
        foreach col in Bt {
            r.append(dot(row, col));
        }
        out.append(r);
    }
    return out;
}

// ---------- statistics ----------

function mean(xs) {
    if len(xs) == 0 {
        throw ValueError("mean(): empty list");
    }
    return sum(xs) / len(xs);
}

function variance(xs) {
    m = mean(xs);
    return sum([x * x for x in xs]) / len(xs) - m * m;
}

function stdev(xs) {
    return sqrt(variance(xs));
}

function median(xs) {
    if len(xs) == 0 {
        throw ValueError("median(): empty list");
    }
    s = sorted(xs);
    n = len(s);
    if n % 2 == 1 {
        return s[n / 2];
    }
    return (s[n / 2 - 1] + s[n / 2]) / 2.0;
}

// scale a list into [0, 1]
function minmax(xs) {
    lo = min(xs);
    hi = max(xs);
    span = hi - lo;
    if span == 0 {
        return [0.0 for x in xs];
    }
    return [(x - lo) / span for x in xs];
}

// z-scores plus the parameters, so inference can reuse them
function standardize(xs) {
    m = mean(xs);
    sd = stdev(xs);
    if sd == 0 {
        sd = 1.0;
    }
    return {"values": [(x - m) / sd for x in xs], "mean": m, "std": sd};
}

// ---------- deterministic randomness ----------

// One step of a classic 32-bit LCG (glibc constants). Fits exactly in 64-bit
// integers on every engine. Pass state onward:
//   r = ai.rng_next(state); x = r.value; state = r.state;
// Values are floats in [0, 1). Same seed => same sequence everywhere.
function rng_next(state) {
    state = (abs(int(state)) % 2147483648 * 1103515245 + 12345) % 2147483648;
    return {"value": state / 2147483648.0, "state": state};
}

// n pseudo-random floats in [0, 1) from a seed
function rand_list(seed, n) {
    state = abs(int(seed)) % 2147483648;
    out = [];
    for (i = 0; i < n; i++) {
        r = rng_next(state);
        state = r.state;
        out.append(r.value);
    }
    return out;
}

// deterministic Fisher-Yates shuffle -> {"train": [...], "test": [...]}
function train_test_split(xs, testRatio, seed) {
    state = abs(int(seed)) % 2147483648;
    idx = [i for i in range(len(xs))];
    for (i = len(idx) - 1; i > 0; i--) {
        state = (state * 1103515245 + 12345) % 2147483648;
        j = int(state / 2147483648.0 * (i + 1));
        t = idx[i];
        idx[i] = idx[j];
        idx[j] = t;
    }
    cut = int(len(xs) * (1.0 - testRatio));
    train = [];
    test = [];
    for (k = 0; k < len(idx); k++) {
        if k < cut {
            train.append(xs[idx[k]]);
        } else {
            test.append(xs[idx[k]]);
        }
    }
    return {"train": train, "test": test};
}

// ---------- supervised learning ----------

function sigmoid(x) {
    return 1.0 / (1.0 + pow(2.718281828459045, -x));
}

function relu(x) {
    if x > 0 {
        return x;
    }
    return 0.0;
}

// least-squares line fit by gradient descent:
//   model = ai.linear_fit(xs, ys, 0.01, 2000)
//   y = model.w * x + model.b
function linear_fit(xs, ys, lr, epochs) {
    if len(xs) != len(ys) || len(xs) == 0 {
        throw ValueError("linear_fit(): xs and ys must be non-empty and the same length");
    }
    n = len(xs);
    w = 0.0;
    b = 0.0;
    loss = 0.0;
    for (e = 0; e < epochs; e++) {
        gw = 0.0;
        gb = 0.0;
        loss = 0.0;
        for (i = 0; i < n; i++) {
            pred = w * xs[i] + b;
            err = pred - ys[i];
            gw += err * xs[i];
            gb += err;
            loss += err * err;
        }
        gw /= n;
        gb /= n;
        loss = loss / (2 * n);
        w -= lr * gw;
        b -= lr * gb;
    }
    return {"w": w, "b": b, "loss": loss};
}

function linear_predict(model, x) {
    return model.w * x + model.b;
}

// classification accuracy of two label lists
function accuracy(pred, actual) {
    if len(pred) != len(actual) || len(pred) == 0 {
        throw ValueError("accuracy(): label lists must be non-empty and the same length");
    }
    hits = 0;
    for (i = 0; i < len(pred); i++) {
        if pred[i] == actual[i] {
            hits += 1;
        }
    }
    return hits / len(pred);
}

function mse(pred, actual) {
    n = len(pred);
    if n == 0 || n != len(actual) {
        throw ValueError("mse(): label lists must be non-empty and the same length");
    }
    return sum([(pred[i] - actual[i]) ** 2 for i in range(n)]) / n;
}

function mae(pred, actual) {
    n = len(pred);
    return sum([abs(pred[i] - actual[i]) for i in range(n)]) / n;
}

// coefficient of determination R^2
function r2(pred, actual) {
    m = mean(actual);
    ssRes = sum([(actual[i] - pred[i]) ** 2 for i in range(len(actual))]);
    ssTot = sum([(y - m) ** 2 for y in actual]);
    if ssTot == 0 {
        return 1.0;
    }
    return 1.0 - ssRes / ssTot;
}

// ---------- unsupervised learning ----------

// k-means over points (list of numeric lists) -> {"centroids", "labels", "inertia"}
function kmeans(points, k, iters) {
    n = len(points);
    if k < 1 || k > n {
        throw ValueError("kmeans(): need 1 <= k <= number of points");
    }
    dims = len(points[0]);
    // pick k spread-out starting points (deterministic)
    centroids = [];
    for (c = 0; c < k; c++) {
        centroids.append([x for x in points[c * n / k]]);
    }
    labels = [0 for p in points];
    for (it = 0; it < iters; it++) {
        // assignment step
        for (i = 0; i < n; i++) {
            best = 0;
            bestD = -1.0;
            for (c = 0; c < k; c++) {
                d = euclid(points[i], centroids[c]);
                if bestD < 0 || d < bestD {
                    bestD = d;
                    best = c;
                }
            }
            labels[i] = best;
        }
        // update step
        sums = [];
        for (c = 0; c < k; c++) {
            sums.append([0.0 for d in range(dims)]);
        }
        counts = [0 for c in range(k)];
        for (i = 0; i < n; i++) {
            counts[labels[i]] += 1;
            for (d = 0; d < dims; d++) {
                sums[labels[i]][d] += points[i][d];
            }
        }
        for (c = 0; c < k; c++) {
            if counts[c] > 0 {
                for (d = 0; d < dims; d++) {
                    centroids[c][d] = sums[c][d] / counts[c];
                }
            }
        }
    }
    inertia = 0.0;
    for (i = 0; i < n; i++) {
        inertia += euclid(points[i], centroids[labels[i]]) ** 2;
    }
    return {"centroids": centroids, "labels": labels, "inertia": inertia};
}

// nearest-centroid classifier (a.k.a. Rocchio / minimum distance)
function nearest_centroid(model, x) {
    best = 0;
    bestD = -1.0;
    for (c = 0; c < len(model.centroids); c++) {
        d = euclid(x, model.centroids[c]);
        if bestD < 0 || d < bestD {
            bestD = d;
            best = c;
        }
    }
    return best;
}
