// sec — security-research toolkit for PyHP (CTF / pentest lab helpers).
// Pure computation over strings and numbers: ciphers, entropy, hexdumps,
// IP math and brute-force helpers. For authorized testing, CTFs and
// education only — use responsibly and legally.
// Deterministic on all three PyHP engines.

// ---------- classical ciphers ----------

// repeating-key XOR over character codes; encrypt == decrypt.
// Round-trips exactly; keep data and key ASCII (< 128) for portability.
function xor_cipher(data, key) {
    if len(key) == 0 {
        throw ValueError("xor_cipher(): key must not be empty");
    }
    out = "";
    for (i = 0; i < len(data); i++) {
        k = ord(key[i % len(key)]);
        out += chr(ord(data[i]) ^ k);
    }
    return out;
}

function caesar(text, shift) {
    out = "";
    n = len(text);
    for (i = 0; i < n; i++) {
        c = text[i];
        o = ord(c);
        if o >= 97 && o <= 122 {          // a-z
            out += chr(97 + (o - 97 + shift % 26 + 26) % 26);
        } elseif o >= 65 && o <= 90 {     // A-Z
            out += chr(65 + (o - 65 + shift % 26 + 26) % 26);
        } else {
            out += c;
        }
    }
    return out;
}

function rot13(text) {
    return caesar(text, 13);
}

// Vigenere: vigenere(text, key) encrypts, vigenere_dec(text, key) decrypts
function vigenere(text, key) {
    out = "";
    j = 0;
    for (i = 0; i < len(text); i++) {
        c = text[i];
        o = ord(c);
        if (o >= 97 && o <= 122) || (o >= 65 && o <= 90) {
            k = ord(key[j % len(key)].lower()) - 97;
            j += 1;
            if o >= 97 {
                out += chr(97 + (o - 97 + k) % 26);
            } else {
                out += chr(65 + (o - 65 + k) % 26);
            }
        } else {
            out += c;
        }
    }
    return out;
}

function vigenere_dec(text, key) {
    invKey = "";
    foreach ch in key {
        invKey += chr(ord("a") + (26 - (ord(ch.lower()) - 97)) % 26);
    }
    return vigenere(text, invKey);
}

// ---------- analysis ----------

// natural log (pure PyHP, deterministic on every engine) via the atanh series
function _ln(x) {
    if x <= 0 {
        throw ValueError("_ln(): requires a positive number");
    }
    k = 0;
    while x > 1.4 { x /= 2; k += 1; }
    while x < 0.7 { x *= 2; k -= 1; }
    y = (x - 1) / (x + 1);
    y2 = y * y;
    acc = 0.0;
    term = y;
    n = 1;
    while n < 60 {
        acc += term / n;
        term *= y2;
        n += 2;
    }
    return 2 * acc + k * 0.6931471805599453;
}

// log base 2
function log2(x) {
    return _ln(x) / 0.6931471805599453;
}

// Shannon entropy in bits per character (0..~8)
function entropy(s) {
    if len(s) == 0 {
        return 0.0;
    }
    freq = {};
    foreach ch in s {
        freq[ch] = freq.get(ch, 0) + 1;
    }
    h = 0.0;
    n = len(s);
    foreach c in values(freq) {
        p = c / n;
        h -= p * log2(p);
    }
    return h;
}

// frequency table as sorted [char, count] pairs (useful for cryptanalysis)
function char_freq(s) {
    freq = {};
    foreach ch in s {
        freq[ch] = freq.get(ch, 0) + 1;
    }
    pairs = [];
    foreach k, v in freq {
        pairs.append([k, v]);
    }
    return sorted(pairs);
}

// classic 16-byte hexdump with ASCII gutter
function hexdump(data) {
    out = "";
    n = len(data);
    for (off = 0; off < n; off += 16) {
        hx = "";
        asc = "";
        for (j = 0; j < 16; j++) {
            if off + j < n {
                o = ord(data[off + j]);
                h = hex(o)[2:];
                if len(h) == 1 {
                    h = "0" + h;
                }
                hx += h + " ";
                if o >= 32 && o < 127 {
                    asc += data[off + j];
                } else {
                    asc += ".";
                }
            } else {
                hx += "   ";
            }
        }
        off4 = hex(off)[2:];
        while len(off4) < 8 {
            off4 = "0" + off4;
        }
        out += off4 + "  " + hx.rstrip() + "  |" + asc + "|\n";
    }
    return out;
}

// ---------- network math ----------

function ip_to_int(ip) {
    parts = ip.split(".");
    if len(parts) != 4 {
        throw ValueError("ip_to_int(): expected 4 octets in '" + ip + "'");
    }
    n = 0;
    foreach p in parts {
        o = int(p);
        if o < 0 || o > 255 {
            throw ValueError("ip_to_int(): bad octet '" + p + "'");
        }
        n = n * 256 + o;
    }
    return n;
}

function int_to_ip(n) {
    n = int(n);
    if n < 0 || n > 4294967295 {
        throw ValueError("int_to_ip(): out of 32-bit range");
    }
    return str((n >> 24) % 256) + "." + str((n >> 16) % 256) + "." + str((n >> 8) % 256) + "." + str(n % 256);
}

// parse "a.b.c.d/prefix" -> {"network", "broadcast", "mask", "first", "last", "hosts"}
function subnet(cidr) {
    parts = cidr.split("/");
    if len(parts) != 2 {
        throw ValueError("subnet(): expected 'a.b.c.d/prefix', got '" + cidr + "'");
    }
    ip = ip_to_int(parts[0]);
    bits = int(parts[1]);
    if bits < 0 || bits > 32 {
        throw ValueError("subnet(): prefix must be 0..32");
    }
    mask = 0;
    if bits > 0 {
        mask = (4294967295 << (32 - bits)) % 4294967296;
    }
    network = ip & mask;
    broadcast = (network | (4294967295 - mask)) % 4294967296;
    hosts = broadcast - network - 1;
    if bits >= 31 {
        hosts = broadcast - network + 1;
    }
    return {
        "network": int_to_ip(network),
        "broadcast": int_to_ip(broadcast),
        "mask": int_to_ip(mask),
        "first": int_to_ip(network + 1),
        "last": int_to_ip(broadcast - 1),
        "hosts": hosts,
        "prefix": bits,
    };
}

// list all host addresses of a /24-ish range (cap it, be kind to networks)
function host_range(cidr, limit) {
    s = subnet(cidr);
    if s.hosts > limit {
        throw ValueError("host_range(): " + str(s.hosts) + " hosts exceeds limit " + str(limit));
    }
    out = [];
    start = ip_to_int(s.network) + 1;
    for (i = 0; i < s.hosts; i++) {
        out.append(int_to_ip(start + i));
    }
    return out;
}

// ---------- brute force & hashing helpers ----------

// deterministic password generator (demo/generator-grade, not a CSPRNG)
function password_gen(length, seed) {
    chars = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789!@#$%^&*";
    r = abs(int(seed)) % 2147483648;
    out = "";
    for (i = 0; i < length; i++) {
        r = (r * 1103515245 + 12345) % 2147483648;
        out += chars[r % len(chars)];
    }
    return out;
}

// sha256 of a file, hex encoded
function hash_file(path) {
    return sha256(file_read(path));
}

// English-likeness score (chi-square against letter frequencies).
// LOWER = more English-like; used by crack_caesar.
function english_score(text) {
    freq = [8.2, 1.5, 2.8, 4.3, 12.7, 2.2, 2.0, 6.1, 7.0, 0.2, 0.8, 4.0, 2.4,
            6.7, 7.5, 1.9, 0.1, 6.0, 6.3, 9.1, 2.8, 1.0, 2.4, 0.2, 2.0, 0.1];
    counts = [0 for i in range(26)];
    total = 0;
    lower = text.lower();
    foreach ch in lower {
        o = ord(ch);
        if o >= 97 && o <= 122 {
            counts[o - 97] += 1;
            total += 1;
        }
    }
    if total == 0 {
        return 999999.0;
    }
    score = 0.0;
    for (i = 0; i < 26; i++) {
        expected = total * freq[i] / 100.0;
        if expected > 0 {
            d = counts[i] - expected;
            score += d * d / expected;
        }
    }
    return score;
}

// brute-force Caesar: try all 26 shifts, return the most English-like one
// (chi-square letter fit, lower = better). Reliable from ~20+ letters; very
// short texts (a few words) can mislead pure frequency scoring — that is
// information theory, not a bug. Longer ciphertexts crack cleanly.
function crack_caesar(cipher) {
    best = "";
    bestShift = 0;
    bestScore = -1.0;
    for (s = 0; s < 26; s++) {
        cand = caesar(cipher, -s);
        score = english_score(cand);
        if bestScore < 0 || score < bestScore {
            bestScore = score;
            best = cand;
            bestShift = s;
        }
    }
    return {"plaintext": best, "shift": bestShift, "score": bestScore};
}
