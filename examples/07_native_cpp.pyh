// PyHP — native C++ blocks: drop real C++ right into a .pyh file.
// Run:  pyhp run examples/07_native_cpp.pyh
// Every cpp export also fuses into a single native binary via
//       pyhp build <file.pyh> --target native -o app && ./app
// (the whole program must be class-free for --target native — the class
//  in 06_helper.pyh means this particular example runs on the PHP engines;
//  the list-bridge demo at the bottom is pure cpp + PyHP, so try moving it
//  into its own file and going native).
//
// Exported functions are declared with a `// pyhp-export:` line. The bridge
// supports int64_t, double and const char* — the classic C ABI.

cpp {
    // pyhp-export: int64_t pyh_fib(int64_t n);
    // pyhp-export: double pyh_hypot(double a, double b);
    // pyhp-export: int64_t pyh_popcount(int64_t x);
    // pyhp-export: const char* pyh_mood(int64_t k);

    int64_t pyh_fib(int64_t n) {           // O(n) iterative Fibonacci
        if (n < 2) return n;
        int64_t a = 0, b = 1;
        for (int64_t i = 1; i < n; i++) { int64_t t = a + b; a = b; b = t; }
        return b;
    }
    double pyh_hypot(double a, double b) { return sqrt(a * a + b * b); }
    int64_t pyh_popcount(int64_t x) {      // Brian Kernighan bit trick
        int64_t c = 0;
        while (x) { x &= x - 1; c++; }
        return c;
    }
    const char* pyh_mood(int64_t k) {
        static const char* moods[] = {"sleepy", "warm", "fast", "blazing"};
        return moods[k % 4];
    }
}

echo "== native C++ inside PyHP ==\n";
echo "pyh_fib(70)     = ", pyh_fib(70), "\n";
echo "pyh_hypot(3,4)  = ", pyh_hypot(3, 4), "\n";
echo "pyh_popcount(255) = ", pyh_popcount(255), "\n";
echo "engine mood     = ", pyh_mood(3), "\n";

// native calls mix freely with pure PyHP code
function pyfib(n) {
    if n < 2 { return n; }
    return pyfib(n - 1) + pyfib(n - 2);
}
echo "pyhp fib(15)    = ", pyfib(15), "\n";

// and they work through modules and the package manager too
m = require("./06_helper.pyh");
echo "module + native = ", m.shout(pyh_mood(2)), "\n";
echo "\n(The first native call compiles the cpp block once with g++, then\n";
echo " every call afterwards is raw machine code. Try --target native to\n";
echo " fuse PyHP and C++ into a single executable with zero PHP involved.)\n";

// ---- lists cross the bridge too (0.6.0) ---------------------------
cpp {
    // pyhp-export: double pyh_mean(pyhp_list xs);
    // pyhp-export: pyhp_list pyh_scaled(pyhp_list xs, int64_t k);
    double pyh_mean(pyhp_list xs) {
        if (xs.len == 0) return 0.0;
        double s = 0.0;
        for (int64_t i = 0; i < xs.len; i++) {
            if (xs.items[i].kind == 1) s += (double)xs.items[i].i;  // kind: 1=int
            if (xs.items[i].kind == 2) s += xs.items[i].f;          // 2=float
        }                                                            // 3=string 0=null
        return s / (double)xs.len;
    }
    pyhp_list pyh_scaled(pyhp_list xs, int64_t k) {
        pyhp_list out;
        out.len = xs.len;
        out.items = (pyhp_val*)std::malloc(sizeof(pyhp_val) * (xs.len > 0 ? xs.len : 1));
        for (int64_t i = 0; i < xs.len; i++) {
            pyhp_val pv; pv.kind = 1; pv.i = xs.items[i].i * k;
            out.items[i] = pv;
        }
        return out;   // malloc'd items: PyHP copies, then calls pyhp_list_free
    }
}
echo "list bridge mean   = ", pyh_mean([1, 2, 3, 4]), "\n";
echo "list bridge scaled = ", pyh_scaled([1, 2, 3], 10), "\n";
