{
    "language": "PyHP",
    "version": "0.4.0",
    "tagline": "PHP syntax, Python brains, C muscles.",
    "fileExtension": ".pyh",
    "runtime": "PHP 8.0+ CLI, no extensions",
    "engines": {
        "interpreter": "tree-walking AST evaluator (pyhp run / pyhp repl)",
        "transpiler": "PyHP -> standalone PHP 8 (pyhp build / pyhp compile)",
        "nativeCpp": "PyHP -> single-file C++17 -> machine code (pyhp build --target cpp|native)",
        "parity": "the 35-case test suite asserts byte-identical output across engines"
    },
    "nativeCpp": {
        "cppBlocks": "cpp { ... } embeds C++17 in a .pyh file; functions declared with `// pyhp-export: <C decl>;` become callable from PyHP",
        "bridgeTypes": [
            "int64_t",
            "double",
            "const char*",
            "void"
        ],
        "exportExample": "// pyhp-export: double pyh_hypot(double a, double b);",
        "bridgeModes": "PHP ext/ffi when available, else a compiled helper binary driven over a tiny line protocol (needs only g++)",
        "cache": "./.pyhp_native/ (override with PYHP_NATIVE_CACHE, compiler with CXX)",
        "nativeBackend": "pyhp build --target cpp -o app.cpp emits C++17; --target native -o app also compiles with g++",
        "nativeSupports": "full value model, operators, methods, slicing, f-strings, comprehensions, top-level functions, foreach/while/for, try/catch/throw, require() of modules and stdlib, cpp blocks, sha256, json, base64/url builtins",
        "nativeNotYet": [
            "classes & super",
            "lambda/function expressions",
            "try/finally",
            "md5/crc32",
            "exec/system/env/sleep/input/malloc_arena",
            "isinstance of classes"
        ],
        "rules": [
            "export names are global — prefix them (pyh_mymod_fn)",
            "first call compiles once, later calls are raw machine code",
            "argument kinds are enforced at call time (TypeError on mismatch)"
        ]
    },
    "lexical": {
        "comments": [
            "// line",
            "# line",
            "/* block */"
        ],
        "statementTerminator": ";",
        "blocks": "braces {} always",
        "variables": "no $ prefix; declared by assignment or annotated decl",
        "stringQuotes": [
            "\"double\"",
            "'single'"
        ],
        "fStrings": "f\"text {expr} more\" — full expressions inside {}",
        "numberLiterals": [
            "42",
            "3.14",
            "0xFF (hex)",
            "0b1010 (binary)"
        ]
    },
    "types": [
        "int",
        "float",
        "string",
        "bool",
        "list",
        "dict",
        "null",
        "user classes",
        "error classes"
    ],
    "staticTyping": {
        "annotations": [
            "int",
            "float",
            "string",
            "bool",
            "list",
            "dict",
            "var",
            "any"
        ],
        "enforcement": "runtime on every assignment; float widens int"
    },
    "operators": {
        "arithmetic": [
            "+",
            "-",
            "*",
            "/",
            "%",
            "**"
        ],
        "comparison": [
            "==",
            "!=",
            "<",
            "<=",
            ">",
            ">="
        ],
        "logical": [
            "and",
            "or",
            "not"
        ],
        "bitwise": [
            "&",
            "|",
            "^",
            "~",
            "<<",
            ">>"
        ],
        "membership": [
            "in",
            "not in"
        ],
        "ternary": "cond ? a : b",
        "compoundAssign": [
            "+=",
            "-=",
            "*=",
            "/=",
            "%=",
            "**=",
            "&=",
            "|=",
            "^=",
            "<<=",
            ">>="
        ],
        "increment": [
            "++",
            "--"
        ],
        "indexing": [
            "xs[i] (negative ok)",
            "xs[a:b]",
            "xs[a:b:step] e.g. xs[::-1]"
        ],
        "notes": [
            "// is a comment, not integer division; / is true division",
            "+ concatenates strings, merges lists and dicts",
            "string * int and list * int repeat"
        ]
    },
    "statements": [
        "if/elseif/else",
        "while",
        "do...while",
        "for(init;cond;update)",
        "foreach x in xs",
        "foreach k, v in xs",
        "break",
        "continue",
        "echo",
        "function",
        "return",
        "class X extends Y",
        "try/catch/finally",
        "throw",
        "varDecl (int x = 5;)",
        "expression statement",
        "cpp { ... } (native C++ block)"
    ],
    "functions": {
        "declaration": "function name(a, b = 5) { ... }",
        "typed": "function name(int a) string { ... }",
        "variadic": "function name(...xs) { ... }",
        "lambda": "double = lambda n: n * 2;",
        "firstClass": true
    },
    "classes": {
        "declaration": "class Dog extends Animal { string name = \"\"; function __construct(n) { this.name = n; } }",
        "constructor": "__construct or __init",
        "stringHook": "__str__ or __toString",
        "superCall": "super(...) and super.method(...)",
        "errors": "built-in error classes behave like normal classes and can be extended"
    },
    "errorClasses": [
        "Exception",
        "TypeError",
        "ValueError",
        "KeyError",
        "IndexError",
        "ZeroDivisionError",
        "MemError",
        "RuntimeError"
    ],
    "modules": {
        "form": "m = require(\"./lib.pyh\") | m = require(\"pkgname\")",
        "exports": "top-level named functions, top-level lambdas, classes (as factories)",
        "access": "m.fn(x), m.value, m[\"fn\"](x); classes: m.ClassName(args)",
        "caching": "per resolved path; same table returned",
        "resolution": [
            "./vendor/<pkg>",
            "$PYHP_REGISTRY/<pkg>",
            "<install>/lib/<name>.pyh (stdlib)",
            "<install>/registry/<pkg>"
        ],
        "compiledMode": "spec must be a literal string; modules are inlined at build time",
        "recommendation": "keep modules stateless (pure functions/classes)"
    },
    "packages": {
        "manifest": "pyhp.json: {name, version, description, main, author, license, dependencies}",
        "cli": [
            "pyhp pkg init [name]",
            "pyhp pkg add <name>[@ver]",
            "pyhp pkg remove <name>",
            "pyhp pkg list"
        ],
        "vendorDir": "vendor/"
    },
    "selfUpdate": {
        "version": "pyhp version [--check] — local info; --check queries GitHub for the latest release",
        "update": "pyhp update [--force] [--main] — download the latest GitHub release zip and copy it over the install dir, preserving bundled php/ and vendor/; git clones update via git pull --ff-only",
        "channels": {
            "release": "https://api.github.com/repos/Stevem100/pyhp/releases/latest (default)",
            "main": "https://codeload.github.com/Stevem100/pyhp/zip/refs/heads/main (--main, also the API-unreachable fallback)"
        }
    },
    "stdlib": {
        "ai": {
            "load": "m = require(\"ai\");",
            "functions": [
                "accuracy",
                "cosine",
                "dot",
                "euclid",
