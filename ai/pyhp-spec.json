                "caesar",
                "char_freq",
                "crack_caesar",
                "english_score",
                "entropy",
                "hash_file",
                "hexdump",
                "host_range",
                "int_to_ip",
                "ip_to_int",
                "log2",
                "password_gen",
                "rot13",
                "subnet",
                "vigenere",
                "vigenere_dec",
                "xor_cipher"
