#!/usr/bin/env php
<?php
/**
 * PyHP — CLI runner + REPL + transpiler driver + self-updater.
 *
 * Usage (see install.sh / install.ps1 for the one-line `pyhp` setup):
 *   pyhp run     <script.pyh> [args...]   run with the tree-walking interpreter
 *   pyhp build   <script.pyh> -o out.php  transpile to standalone PHP
 *   pyhp compile <script.pyh> [args...]   transpile + execute (fast path)
 *   pyhp repl                             interactive shell
 *   pyhp version [--check]                version info (+ latest on GitHub)
 *   pyhp update [--force] [--main]        self-update from GitHub
 *   pyhp pkg init|add|remove|list         package manager
 *   pyhp help
 */

require_once __DIR__ . '/../src/runtime.php';
require_once __DIR__ . '/../src/Lexer.php';
require_once __DIR__ . '/../src/Parser.php';
require_once __DIR__ . '/../src/Interpreter.php';
require_once __DIR__ . '/../src/Transpiler.php';

const PYHP_CLI = true;

function pyhp_usage(): void {
    $v = PYHP_VERSION;
    echo <<<TXT
PyHP {$v} — PHP syntax, Python brains, C muscles.

  pyhp run <script.pyh> [args...]      run via the built-in interpreter
                                       (add --tree to skip the bytecode VM)
  pyhp langs [php|python|cpp|js|full]  offline syntax/function bridge to other
                                       languages — no other runtime needed
  pyhp build <script.pyh> -o out.php   transpile to a standalone PHP file
  pyhp build <f.pyh> --target cpp -o app.cpp    transpile to C++17 source
  pyhp build <f.pyh> --target native -o app     transpile + g++ -> native binary
  pyhp compile <script.pyh> [args...]  transpile + run (fast path)
  pyhp repl                            start the interactive shell
  pyhp pkg init|add|remove|list        manage packages (vendor/ + pyhp.json)
  pyhp version [--check]               show version info (--check: query GitHub)
  pyhp update [--force] [--main]       update PyHP from GitHub releases

Examples:
  pyhp run examples/01_hello.pyh
  pyhp build examples/01_hello.pyh -o /tmp/hello.php && php /tmp/hello.php
  pyhp pkg add mathx
  pyhp version --check
  pyhp update
  pyhp repl

TXT;
}

function pyhp_fail(Throwable $e): int {
    $msg = $e->getMessage();
    if ($e instanceof PyHPError) {
        fwrite(STDERR, "PyHP " . $e->pyhpType . ": " . $msg . "\n");
    } elseif ($e instanceof PyHPSyntaxError) {
        fwrite(STDERR, "PyHP SyntaxError: " . $msg . "\n");
    } else {
        fwrite(STDERR, "PyHP internal error: " . get_class($e) . ": " . $msg . "\n");
    }
    return 1;
}

/* ----------------------------------------------------------------- */
/* script execution (interpreter)                                    */
/* ----------------------------------------------------------------- */

function pyhp_run_file(string $path, array $scriptArgs): int {
    $engine = 'vm';
    $filtered = [];
    foreach ($scriptArgs as $a) {
        if ($a === '--tree' || $a === '--no-vm') { $engine = 'tree'; continue; }
        if ($a === '--vm') { $engine = 'vm'; continue; }
        $filtered[] = $a;
    }
    $scriptArgs = $filtered;
    if (!is_file($path)) {
        fwrite(STDERR, "PyHP: cannot find script '{$path}'\n");
        return 1;
    }
    $src = file_get_contents($path);
    pyhp_set_argv($scriptArgs);
    try {
        $stmts = PyHPParser::parseSource($src);
        $interp = new PyHPInterpreter();
        $interp->setMainFile($path);
        $interp->runProgram($stmts, $engine);
        return 0;
    } catch (PyHPExit $e) {
        return $e->exitCode;
    } catch (PyHPThrow $t) {
        $inst = $t->value;
        fwrite(STDERR, "PyHP uncaught exception " . pyhp_type_name($inst) . ": " . pyhp_tostr($inst) . "\n");
        return 1;
    } catch (PyHPError $e) {
        return pyhp_fail($e);
    }
}

/* ----------------------------------------------------------------- */
/* transpile + compile-run                                           */
/* ----------------------------------------------------------------- */

function pyhp_build_file(string $path, string $out, string $target = 'php'): int {
    if (!is_file($path)) {
        fwrite(STDERR, "PyHP: cannot find script '{$path}'\n");
        return 1;
    }
    try {
        $stmts = PyHPParser::parseSource(file_get_contents($path));
        if ($target === 'cpp' || $target === 'native') {
            require_once __DIR__ . '/../src/CppTranspiler.php';
            $t = new PyHPCppTranspiler();
            $t->setSourceFile($path);
            $cpp = $t->transpile($stmts);
            if ($target === 'cpp') {
                file_put_contents($out, $cpp);
                echo "compiled {$path} -> {$out} (C++17 source; build with: g++ -O2 -std=c++17 -o app " . basename($out) . ")\n";
                return 0;
            }
            $cxx = getenv('CXX') ?: 'g++';
            $tmpCpp = (is_dir(dirname($out)) ? $out : getcwd() . '/' . $out) . '.tmp.cpp';
            file_put_contents($tmpCpp, $cpp);
            $cmd = $cxx . ' -O2 -std=c++17 -o ' . escapeshellarg($out) . ' ' . escapeshellarg($tmpCpp) . ' 2>&1';
            exec($cmd, $lines, $code);
            @unlink($tmpCpp);
            if ($code !== 0) {
                fwrite(STDERR, "PyHP: native build failed ({$cxx}):\n" . implode("\n", array_slice($lines, 0, 40)) . "\n");
                return 1;
            }
            echo "compiled {$path} -> {$out} (native executable)\n";
            return 0;
        }
        $t = new PyHPTranspiler();
        $t->setSourceFile($path);
        $php = $t->transpile($stmts, $out);
        file_put_contents($out, $php);
        echo "compiled {$path} -> {$out}\n";
        return 0;
    } catch (PyHPError $e) {
        return pyhp_fail($e);
    }
}

function pyhp_compile_run(string $path, array $scriptArgs): int {
    $tmp = tempnam(sys_get_temp_dir(), 'pyhp_compiled_') . '.php';
    try {
        $stmts = PyHPParser::parseSource(file_get_contents($path));
        $t = new PyHPTranspiler();
        $t->setSourceFile($path);
        $php = $t->transpile($stmts, $tmp);
        file_put_contents($tmp, $php);
    } catch (PyHPError $e) {
        @unlink($tmp);
        return pyhp_fail($e);
    }
    // hand argv to the generated file, then run it in this process
    pyhp_set_argv($scriptArgs);
    try {
        require $tmp;
        $code = 0;
    } catch (PyHPError $e) {
        $code = pyhp_fail($e);
    } catch (PyHPThrow $t) {
        $inst = $t->value;
        fwrite(STDERR, "PyHP uncaught exception " . pyhp_type_name($inst) . ": " . pyhp_tostr($inst) . "\n");
        $code = 1;
    }
    @unlink($tmp);
    return $code;
}

/* ----------------------------------------------------------------- */
/* REPL                                                              */
/* ----------------------------------------------------------------- */

function pyhp_repl(): int {
    echo "PyHP " . PYHP_VERSION . " interactive shell — PHP syntax, Python brains, C muscles.\n";
    echo "Type :help for commands, :quit (or Ctrl-D) to exit.\n\n";
    $interp = new PyHPInterpreter();
    $buffer = '';
    while (true) {
        $prompt = $buffer === '' ? 'pyhp> ' : '....> ';
        if (function_exists('readline')) {
            $line = readline($prompt);
        } else {
            echo $prompt;
            $line = fgets(STDIN);
            if ($line !== false) $line = rtrim($line, "\r\n");
        }
        if ($line === false || $line === null) { echo "\n"; break; } // Ctrl-D
        if (function_exists('readline_add_history')) { readline_add_history($line); }
        $trimmed = trim($line);
        if ($buffer === '' && str_starts_with($trimmed, ':')) {
            $cmd = strtolower($trimmed);
            if ($cmd === ':quit' || $cmd === ':exit' || $cmd === ':q') break;
            if ($cmd === ':help') {
                echo "  :help   show this help\n  :vars   dump all global variables\n  :quit   exit the shell\n";
                echo "Tip: statements need semicolons; a bare expression prints its value.\n";
                continue;
            }
            if ($cmd === ':vars') {
                foreach ($interp->global->vars as $k => $v) {
                    if (in_array($k, array_keys(pyhp_builtins()), true)) continue;
                    echo "  {$k} = " . pyhp_repr($v) . "\n";
                }
                continue;
            }
            echo "unknown command: {$trimmed}\n";
            continue;
        }
        $buffer .= $line . "\n";
        if (!pyhp_balanced($buffer)) continue;

        $src = $buffer;
        $buffer = '';
        // allow bare expressions without a trailing semicolon (REPL nicety)
        $rt = rtrim($src);
        if ($rt !== '' && !str_ends_with($rt, ';') && !str_ends_with($rt, '}')) {
            $src = $rt . ';';
        }
        try {
            $stmts = PyHPParser::parseSource($src);
            $value = $interp->runProgram($stmts);
            if ($value !== null && count($stmts) === 1 && $stmts[0]['k'] === 'Expr'
                && !in_array($stmts[0]['e']['k'], ['Assign', 'Post'], true)) {
                echo "=> " . pyhp_repr($value) . "\n";
            }
        } catch (PyHPError $e) {
            echo "Error: " . $e->pyhpType . ": " . $e->message . "\n";
        } catch (PyHPThrow $t) {
            echo "Uncaught exception: " . pyhp_tostr($t->value) . "\n";
        } catch (PyHPExit $e) {
            break;
        }
    }
    return 0;
}

function pyhp_balanced(string $s): bool {
    $depth = 0;
    $inStr = null;
    $n = strlen($s);
    for ($i = 0; $i < $n; $i++) {
        $c = $s[$i];
        if ($inStr !== null) {
            if ($c === '\\') { $i++; continue; }
            if ($c === $inStr) $inStr = null;
            continue;
        }
        if ($c === '"' || $c === "'") { $inStr = $c; continue; }
        if ($c === '/' && $i + 1 < $n && $s[$i + 1] === '/') { // line comment
            while ($i < $n && $s[$i] !== "\n") $i++;
            continue;
        }
        if ($c === '#') { while ($i < $n && $s[$i] !== "\n") $i++; continue; }
        if ($c === '{' || $c === '(' || $c === '[') $depth++;
        if ($c === '}' || $c === ')' || $c === ']') $depth--;
    }
    return $depth <= 0;
}

/* ----------------------------------------------------------------- */
/* version & self-update                                             */
/* ----------------------------------------------------------------- */

const PYHP_REPO_API  = 'https://api.github.com/repos/Stevem100/pyhp/releases/latest';
const PYHP_REPO_MAIN = 'https://codeload.github.com/Stevem100/pyhp/zip/refs/heads/main';

function pyhp_http_get(string $url, string &$err = ''): ?string {
    $err = '';
    if (function_exists('curl_init')) {
        $ch = curl_init($url);
        curl_setopt_array($ch, [
            CURLOPT_RETURNTRANSFER => true,
            CURLOPT_FOLLOWLOCATION => true,
            CURLOPT_USERAGENT      => 'pyhp-cli/' . PYHP_VERSION,
            CURLOPT_TIMEOUT        => 180,
            CURLOPT_CONNECTTIMEOUT => 15,
        ]);
        $data = curl_exec($ch);
        $code = (int)curl_getinfo($ch, CURLINFO_RESPONSE_CODE);
        $cerr = curl_error($ch);
        curl_close($ch);
        if ($data === false || $data === null) { $err = $cerr !== '' ? $cerr : 'request failed'; return null; }
        if ($code !== 200) { $err = "HTTP {$code}"; return null; }
        return $data;
    }
    $ctx = stream_context_create(['http' => [
        'header' => "User-Agent: pyhp-cli/" . PYHP_VERSION . "\r\n",
        'timeout' => 180,
        'follow_location' => 1,
        'ignore_errors' => false,
    ]]);
    $data = @file_get_contents($url, false, $ctx);
    if ($data === false) { $err = 'request failed'; return null; }
    return $data;
}

function pyhp_http_download(string $url, string $dest): bool {
    if (function_exists('curl_init')) {
        $fh = fopen($dest, 'wb');
        if ($fh !== false) {
            $ch = curl_init($url);
            curl_setopt_array($ch, [
                CURLOPT_FILE           => $fh,
                CURLOPT_FOLLOWLOCATION => true,
                CURLOPT_USERAGENT      => 'pyhp-cli/' . PYHP_VERSION,
                CURLOPT_TIMEOUT        => 600,
            ]);
            $ok = curl_exec($ch) === true && (int)curl_getinfo($ch, CURLINFO_RESPONSE_CODE) === 200;
            curl_close($ch);
            fclose($fh);
            if ($ok && filesize($dest) > 0) return true;
            @unlink($dest);
        }
    }
    $ctx = stream_context_create(['http' => [
        'header' => "User-Agent: pyhp-cli/" . PYHP_VERSION . "\r\n",
        'timeout' => 600,
        'follow_location' => 1,
    ]]);
    $data = @file_get_contents($url, false, $ctx);
    if ($data !== false && file_put_contents($dest, $data) !== false && filesize($dest) > 0) return true;
    foreach (['curl -fsSL', 'wget -qO-'] as $tool) {
        exec($tool . ' ' . escapeshellarg($url) . ' > ' . escapeshellarg($dest) . ' 2>/dev/null', $o, $code);
        if ($code === 0 && is_file($dest) && filesize($dest) > 0) return true;
        @unlink($dest);
    }
    return false;
}

function pyhp_extract_zip(string $zipPath, string $dest): bool {
    if (class_exists('ZipArchive')) {
        $z = new ZipArchive();
        if ($z->open($zipPath) === true) {
            $ok = $z->extractTo($dest);
            $z->close();
            if ($ok) return true;
        }
    }
    if (class_exists('PharData')) {
        try {
            $p = new PharData($zipPath);
            $p->extractTo($dest, null, true);
            return true;
        } catch (Throwable $e) { /* fall through to shell tools */ }
    }
    if (DIRECTORY_SEPARATOR === '\\') {
        $zp = str_replace('/', '\\', $zipPath);
        $dp = str_replace('/', '\\', $dest);
        exec('powershell -NoProfile -Command "Expand-Archive -Path ' . escapeshellarg($zp) .
             ' -DestinationPath ' . escapeshellarg($dp) . ' -Force"', $o, $code);
        return $code === 0;
    }
    exec('unzip -q -o ' . escapeshellarg($zipPath) . ' -d ' . escapeshellarg($dest), $o, $code);
    return $code === 0;
}

/** copy every file/dir under $src over $dst, skipping top-level names in $skip */
function pyhp_copy_over(string $src, string $dst, array $skip = []): int {
    $n = 0;
    $it = new RecursiveIteratorIterator(
        new RecursiveDirectoryIterator($src, FilesystemIterator::SKIP_DOTS),
        RecursiveIteratorIterator::SELF_FIRST);
    foreach ($it as $item) {
        $rel = $it->getSubPathName();
        $top = strtok($rel, '/');
        if (in_array($top, $skip, true)) continue;
        $target = $dst . '/' . $rel;
        if ($item->isDir()) {
            if (!is_dir($target)) @mkdir($target, 0777, true);
        } else {
            if (!is_dir(dirname($target))) @mkdir(dirname($target), 0777, true);
            if (@copy($item->getPathname(), $target)) $n++;
        }
    }
    return $n;
}

function pyhp_install_root(): string {
    return dirname(__DIR__);
}

function pyhp_latest_release(): ?array {
    $j = pyhp_http_get(PYHP_REPO_API);
    if ($j === null) return null;
    $d = json_decode($j, true);
    if (!is_array($d) || empty($d['tag_name'])) return null;
    $assets = [];
    foreach (($d['assets'] ?? []) as $a) {
        if (isset($a['name'], $a['browser_download_url']) && str_ends_with(strtolower($a['name']), '.zip')) {
            $assets[] = $a;
        }
    }
    return [
        'tag'     => (string)$d['tag_name'],
        'version' => ltrim((string)$d['tag_name'], 'vV'),
        'assets'  => $assets,
        'url'     => $d['html_url'] ?? ('https://github.com/Stevem100/pyhp/releases'),
    ];
}

function pyhp_version_cmd(array $args): int {
    $root = pyhp_install_root();
    echo "PyHP " . PYHP_VERSION . "\n";
    echo "php     : " . PHP_VERSION . " (" . PHP_SAPI . ")\n";
    echo "install : " . $root . "\n";
    echo "source  : " . (is_dir($root . '/.git')
        ? "git clone ('pyhp update' runs git pull)"
        : "release install ('pyhp update' pulls GitHub releases)") . "\n";
    if (!in_array('--check', $args, true)) return 0;
    $rel = pyhp_latest_release();
    if ($rel === null) {
        echo "latest  : (github.com unreachable or rate-limited right now)\n";
        return 0;
    }
    $up = version_compare($rel['version'], PYHP_VERSION, '>');
    echo "latest  : " . $rel['tag'] . ($up
        ? "  — update available, run: pyhp update\n"
        : "  — up to date\n");
    return 0;
}

function pyhp_self_update(array $args): int {
    $force   = in_array('--force', $args, true);
    $useMain = in_array('--main', $args, true);
    $root    = pyhp_install_root();
    echo "PyHP " . PYHP_VERSION . " — checking for updates...\n";

    /* git clone: update with git itself */
    if (is_dir($root . '/.git')) {
        exec('cd ' . escapeshellarg($root) . ' && git fetch origin 2>&1', $out, $code);
        if ($code !== 0) {
            fwrite(STDERR, "pyhp update: git fetch failed:\n  " . implode("\n  ", array_slice($out, 0, 5)) . "\n");
            return 1;
        }
        exec('cd ' . escapeshellarg($root) . ' && git log --oneline HEAD..origin/main 2>&1', $behind, $c2);
        if ($c2 === 0 && count($behind) === 0) {
            echo "already up to date (git clone is at the latest main)\n";
            return 0;
        }
        exec('cd ' . escapeshellarg($root) . ' && git pull --ff-only origin main 2>&1', $pulled, $c3);
        echo implode("\n", array_slice($pulled, 0, 12)) . "\n";
        if ($c3 !== 0) {
            fwrite(STDERR, "pyhp update: git pull failed (local changes?) — fix manually or reinstall\n");
            return 1;
        }
        echo "done. run: pyhp version\n";
        return 0;
    }

    /* release install: pick what to download */
    $rel = $useMain ? null : pyhp_latest_release();
    $zipUrl = null; $label = null; $ver = null;
    if ($useMain) {
        $zipUrl = PYHP_REPO_MAIN; $label = 'main branch'; $ver = 'main';
    } elseif ($rel === null) {
        echo "  (could not reach the GitHub releases API — falling back to the main branch)\n";
        $zipUrl = PYHP_REPO_MAIN; $label = 'main branch'; $ver = 'main';
    } else {
        if (!$force && version_compare($rel['version'], PYHP_VERSION, '<=')) {
            echo "already up to date (latest release: " . $rel['tag'] . ")\n";
            return 0;
        }
        $ver = $rel['version'];
        $label = $rel['tag'];
        $zipUrl = null;
        foreach ($rel['assets'] as $a) {
            if (stripos($a['name'], 'pyhp') !== false) { $zipUrl = $a['browser_download_url']; break; }
        }
        if ($zipUrl === null && count($rel['assets']) > 0) $zipUrl = $rel['assets'][0]['browser_download_url'];
        if ($zipUrl === null) $zipUrl = 'https://codeload.github.com/Stevem100/pyhp/zip/refs/tags/' . $rel['tag'];
    }

    $tmp = sys_get_temp_dir() . '/pyhp-update-' . getmypid() . '-' . uniqid();
    if (!@mkdir($tmp . '/x', 0777, true)) {
        fwrite(STDERR, "pyhp update: cannot create temp dir {$tmp}\n");
        return 1;
    }
    $zipPath = $tmp . '/pyhp.zip';
    echo "downloading {$label}...\n";
    if (!pyhp_http_download($zipUrl, $zipPath)) {
        fwrite(STDERR, "pyhp update: download failed ({$zipUrl})\n");
        exec((DIRECTORY_SEPARATOR === '\\' ? 'rmdir /S /Q ' : 'rm -rf ') . escapeshellarg($tmp));
        return 1;
    }
    echo "extracting...\n";
    if (!pyhp_extract_zip($zipPath, $tmp . '/x')) {
        fwrite(STDERR, "pyhp update: could not extract the downloaded zip\n");
        exec((DIRECTORY_SEPARATOR === '\\' ? 'rmdir /S /Q ' : 'rm -rf ') . escapeshellarg($tmp));
        return 1;
    }
    $inner = null;
    foreach (scandir($tmp . '/x') ?: [] as $d) {
        if ($d[0] === '.') continue;
        if (is_file($tmp . '/x/' . $d . '/bin/pyhp') && is_file($tmp . '/x/' . $d . '/src/runtime.php')) {
            $inner = $tmp . '/x/' . $d;
            break;
        }
    }
    if ($inner === null) {
        fwrite(STDERR, "pyhp update: unexpected zip layout (no bin/pyhp + src/runtime.php inside)\n");
        exec((DIRECTORY_SEPARATOR === '\\' ? 'rmdir /S /Q ' : 'rm -rf ') . escapeshellarg($tmp));
        return 1;
    }
    $newV = 'unknown';
    $rt = (string)@file_get_contents($inner . '/src/runtime.php');
    if (preg_match("/PYHP_VERSION\\s*=\\s*'([^']+)'/", $rt, $m)) $newV = $m[1];
    $n = pyhp_copy_over($inner, $root, ['php', '.git']);
    exec((DIRECTORY_SEPARATOR === '\\' ? 'rmdir /S /Q ' : 'rm -rf ') . escapeshellarg($tmp));
    echo "updated {$n} files -> {$root}\n";
    echo "PyHP updated to {$newV}. New shells pick it up automatically; run: pyhp version\n";
    return 0;
}

/* ----------------------------------------------------------------- */
/* package manager (pyhp pkg)                                        */
/* ----------------------------------------------------------------- */

function pyhp_pkg_registry_dirs(): array {
    $dirs = [];
    $cwd = getcwd();
    if ($cwd !== false && is_dir($cwd . '/registry')) $dirs[] = $cwd . '/registry';
    $env = getenv('PYHP_REGISTRY');
    if ($env !== false && $env !== '' && is_dir($env)) $dirs[] = $env;
    $home = dirname(__DIR__);
    if (is_dir($home . '/registry')) $dirs[] = $home . '/registry';
    return $dirs;
}

function pyhp_pkg_read_manifest(string $dir): array {
    $man = $dir . '/pyhp.json';
    if (!is_file($man)) return [];
    $j = json_decode((string)file_get_contents($man), true);
    return is_array($j) ? $j : [];
}

function pyhp_pkg_write_manifest(string $dir, array $m): void {
    file_put_contents($dir . '/pyhp.json',
        json_encode($m, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . "\n");
}

function pyhp_pkg_copy_dir(string $src, string $dst): void {
    if (!is_dir($dst)) mkdir($dst, 0777, true);
    $it = new RecursiveIteratorIterator(
        new RecursiveDirectoryIterator($src, FilesystemIterator::SKIP_DOTS),
        RecursiveIteratorIterator::SELF_FIRST);
    foreach ($it as $item) {
        $target = $dst . '/' . $it->getSubPathName();
        if ($item->isDir()) { if (!is_dir($target)) mkdir($target, 0777, true); }
        else copy($item->getPathname(), $target);
    }
}

/** Base URLs of remote registries: PYHP_REGISTRY (http/https) plus the
 *  project manifest's "registries" list. A registry serves index.json:
 *  {"packages": {"<name>": {"<version>": {"url": "...", "sha256": "..."}}}} */
function pyhp_pkg_remote_registries(array $man): array {
    $urls = [];
    $env = getenv('PYHP_REGISTRY');
    if ($env !== false && preg_match('#^https?://#i', $env)) $urls[] = rtrim($env, '/');
    foreach ((array)($man['registries'] ?? []) as $r) {
        if (is_string($r) && preg_match('#^https?://#i', $r)) $urls[] = rtrim($r, '/');
    }
    return array_values(array_unique($urls));
}

/** Extract a package zip; returns the directory that holds pyhp.json. */
function pyhp_zip_extract_pkg(string $zipFile, string $dest): ?string {
    if (!class_exists('ZipArchive')) return null;
    $zip = new ZipArchive();
    if ($zip->open($zipFile) !== true) return null;
    if (!is_dir($dest)) mkdir($dest, 0777, true);
    $zip->extractTo($dest);
    $zip->close();
    if (is_file($dest . '/pyhp.json')) return $dest;
    foreach (scandir($dest) ?: [] as $d) {
        if ($d[0] === '.') continue;
        if (is_file($dest . '/' . $d . '/pyhp.json')) return $dest . '/' . $d;
    }
    return null;
}

/** Deterministic content hash of a package directory (sorted relpaths). */
function pyhp_pkg_dir_sha(string $dir): string {
    $paths = [];
    $it = new RecursiveIteratorIterator(
        new RecursiveDirectoryIterator($dir, FilesystemIterator::SKIP_DOTS));
    foreach ($it as $item) { if ($item->isFile()) $paths[] = $it->getSubPathName(); }
    sort($paths, SORT_STRING);
    $ctx = hash_init('sha256');
    foreach ($paths as $p) {
        hash_update($ctx, str_replace('\\', '/', $p) . "\n");
        hash_update($ctx, hash_file('sha256', $dir . '/' . $p) . "\n");
    }
    return hash_final($ctx);
}

function pyhp_lock_read(string $cwd): array {
    $f = $cwd . '/pyhp.lock.json';
    if (!is_file($f)) return [];
    $j = json_decode((string)file_get_contents($f), true);
    return is_array($j) ? $j : [];
}

function pyhp_lock_write(string $cwd, array $lock): void {
    file_put_contents($cwd . '/pyhp.lock.json',
        json_encode($lock, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE) . "\n");
}

function pyhp_lock_set(array &$lock, string $name, string $ver, string $source, string $sha): void {
    $lock['lock'] = 1;
    $lock['packages'][$name] = ['version' => $ver, 'source' => $source, 'sha256' => $sha];
}

/** Install one package into vendor/ from a resolved source. Returns version. */
function pyhp_pkg_install_source(string $cwd, string $name, array $res): string {
    $vend = $cwd . '/vendor/' . $name;
    if (is_dir($vend)) {
        $it = new RecursiveIteratorIterator(
            new RecursiveDirectoryIterator($vend, FilesystemIterator::SKIP_DOTS),
            RecursiveIteratorIterator::CHILD_FIRST);
        foreach ($it as $item) { $item->isDir() ? @rmdir($item->getPathname()) : @unlink($item->getPathname()); }
        @rmdir($vend);
    }
    if ($res['kind'] === 'dir') {
        pyhp_pkg_copy_dir($res['dir'], $vend);
    } else {
        $tmp = sys_get_temp_dir() . '/pyhp-pkg-' . bin2hex(random_bytes(6));
        $root = pyhp_zip_extract_pkg($res['file'], $tmp);
        if ($root === null) { fwrite(STDERR, "pkg: not a valid package zip (no pyhp.json): {$res['file']}\n"); exit(1); }
        pyhp_pkg_copy_dir($root, $vend);
        $it = new RecursiveIteratorIterator(
            new RecursiveDirectoryIterator($tmp, FilesystemIterator::SKIP_DOTS),
            RecursiveIteratorIterator::CHILD_FIRST);
        foreach ($it as $item) { $item->isDir() ? @rmdir($item->getPathname()) : @unlink($item->getPathname()); }
        @rmdir($tmp);
    }
    $meta = pyhp_pkg_read_manifest($vend);
    return $meta['version'] ?? $res['version'] ?? '0.0.0';
}

/** Resolve a package spec to an installable source.
 *  Order: local registry dirs -> remote registries (index.json) -> the spec
 *  itself as a zip URL. Remote zips are sha256-verified when the index or a
 *  #sha256= fragment provides one. */
function pyhp_pkg_resolve(string $name, ?string $wantVer): array {
    $dir = pyhp_pkg_locate($name);
    if ($dir !== null) {
        $meta = pyhp_pkg_read_manifest($dir);
        $ver = $meta['version'] ?? '0.0.0';
        if ($wantVer !== null && $wantVer !== $ver) {
            fwrite(STDERR, "pkg: requested {$name}@{$wantVer} but the registry has {$ver}\n");
            exit(1);
        }
        return ['kind' => 'dir', 'dir' => $dir, 'version' => $ver,
                'source' => 'registry:' . $dir, 'sha256' => pyhp_pkg_dir_sha($dir)];
    }
    foreach (pyhp_pkg_remote_registries(pyhp_pkg_read_manifest(getcwd() ?: '.')) as $base) {
        $err = '';
        $body = pyhp_http_get($base . '/index.json', $err);
        if ($body === null) { fwrite(STDERR, "pkg: registry {$base} unreachable ({$err})\n"); continue; }
        $idx = json_decode($body, true);
        $entryV = $idx['packages'][$name] ?? null;
        if (!is_array($entryV)) continue;
        $cands = array_keys($entryV);
        if (count($cands) === 0) continue;
        usort($cands, 'version_compare');
        $ver = $wantVer ?? end($cands);
        if (!isset($entryV[$ver]) || !is_array($entryV[$ver])) {
            fwrite(STDERR, "pkg: registry {$base} has {$name} " . implode(', ', $cands) . " — not {$ver}\n");
            exit(1);
        }
        $url = $entryV[$ver]['url'] ?? null;
        if ($url === null) { fwrite(STDERR, "pkg: registry entry for {$name}@{$ver} has no url\n"); exit(1); }
        $sha = $entryV[$ver]['sha256'] ?? null;
        $tmp = sys_get_temp_dir() . '/pyhp-pkg-' . bin2hex(random_bytes(6)) . '.zip';
        $err = '';
        $zipBody = pyhp_http_get($url, $err);
        if ($zipBody === null) { fwrite(STDERR, "pkg: download failed: {$url} ({$err})\n"); exit(1); }
        file_put_contents($tmp, $zipBody);
        $got = hash_file('sha256', $tmp);
        if ($sha !== null && $got !== $sha) {
            fwrite(STDERR, "pkg: checksum mismatch for {$name}@{$ver}\n  expected {$sha}\n  got      {$got}\n");
            exit(1);
        }
        return ['kind' => 'zip', 'file' => $tmp, 'version' => $ver, 'url' => $url,
                'source' => $url, 'sha256' => $sha ?? $got];
    }
    return null;
}

function pyhp_pkg_init(array $args): int {
    $cwd = getcwd();
    if ($cwd === false) { fwrite(STDERR, "pkg: cannot determine working directory\n"); return 1; }
    if (is_file($cwd . '/pyhp.json')) {
        fwrite(STDERR, "pkg: pyhp.json already exists in this directory\n");
        return 1;
    }
    $name = $args[0] ?? basename($cwd);
    $name = preg_replace('/[^A-Za-z0-9_.-]/', '-', $name);
    $man = [
        'name' => $name,
        'version' => '0.1.0',
        'description' => '',
        'main' => "src/{$name}.pyh",
        'author' => '',
        'license' => 'MIT',
        'dependencies' => new stdClass(),
    ];
    if (!is_dir($cwd . '/src')) mkdir($cwd . '/src', 0777, true);
    $entry = $cwd . "/src/{$name}.pyh";
    if (!is_file($entry)) {
        file_put_contents($entry, "// {$name} — a PyHP package.\n// Functions defined at the top level are exported to require(\"{$name}\").\n\nfunction hello(who) {\n    return \"hello from {$name}, \" + who + \"!\";\n}\n");
    }
    pyhp_pkg_write_manifest($cwd, $man);
    echo "initialized package {$name} in " . $cwd . "\n";
    echo "  manifest : pyhp.json\n  entry    : src/{$name}.pyh\n";
    return 0;
}

function pyhp_pkg_locate(string $name): ?string {
    foreach (pyhp_pkg_registry_dirs() as $reg) {
        $dir = $reg . '/' . $name;
        if (is_dir($dir) && is_file($dir . '/pyhp.json')) return $dir;
    }
    return null;
}

function pyhp_pkg_add(array $args): int {
    if (!isset($args[0])) { fwrite(STDERR, "usage: pyhp pkg add <name|url>[@version]\n"); return 1; }
    $spec = $args[0];
    $cwd = getcwd();
    if ($cwd === false || !is_file($cwd . '/pyhp.json')) {
        fwrite(STDERR, "pkg: no pyhp.json here — run 'pyhp pkg init' first\n");
        return 1;
    }
    $isUrl = (bool)preg_match('#^(https?|file)://#i', $spec);
    $at = strrpos($spec, '@');
    $wantVer = ($at !== false && !$isUrl) ? substr($spec, $at + 1) : null;
    $name = ($at !== false && !$isUrl) ? substr($spec, 0, $at) : $spec;

    if ($isUrl) {
        $err = '';
        $body = pyhp_http_get($spec, $err);
        if ($body === null) { fwrite(STDERR, "pkg: download failed: {$spec} ({$err})\n"); return 1; }
        $tmp = sys_get_temp_dir() . '/pyhp-pkg-' . bin2hex(random_bytes(6)) . '.zip';
        file_put_contents($tmp, $body);
        $sha = hash_file('sha256', $tmp);
        $frag = parse_url($spec, PHP_URL_FRAGMENT) ?? '';
        if (strpos($frag, 'sha256=') === 0 && substr($frag, 7) !== $sha) {
            fwrite(STDERR, "pkg: checksum mismatch for {$spec}\n  expected " . substr($frag, 7) . "\n  got      {$sha}\n");
            return 1;
        }
        $probe = sys_get_temp_dir() . '/pyhp-pkg-' . bin2hex(random_bytes(6));
        $root = pyhp_zip_extract_pkg($tmp, $probe);
        if ($root === null) { fwrite(STDERR, "pkg: not a valid package zip (no pyhp.json inside)\n"); return 1; }
        $meta = pyhp_pkg_read_manifest($root);
        $name = $meta['name'] ?? basename(parse_url($spec, PHP_URL_PATH) ?? 'package');
        $name = preg_replace('/[^A-Za-z0-9_.-]/', '-', $name);
        $ver = $meta['version'] ?? '0.0.0';
        if ($wantVer !== null && $wantVer !== $ver) {
            fwrite(STDERR, "pkg: requested {$wantVer} but the package is {$ver}\n");
            return 1;
        }
        $got = pyhp_pkg_install_source($cwd, $name, ['kind' => 'zip', 'file' => $tmp, 'version' => $ver]);
        $lock = pyhp_lock_read($cwd);
        pyhp_lock_set($lock, $name, $got, $spec, $sha);
        pyhp_lock_write($cwd, $lock);
        $man = pyhp_pkg_read_manifest($cwd);
        $deps = $man['dependencies'] ?? [];
        $deps[$name] = $got;
        $man['dependencies'] = $deps;
        pyhp_pkg_write_manifest($cwd, $man);
        echo "added {$name}@{$got} from {$spec} -> vendor/{$name}\n";
        echo "pinned in pyhp.lock.json (sha256 " . substr($sha, 0, 12) . "…)\n";
        echo "use it:   m = require(\"{$name}\");\n";
        return 0;
    }

    $res = pyhp_pkg_resolve($name, $wantVer);
    if ($res === null) {
        fwrite(STDERR, "pkg: package '{$name}' not found\n");
        $regs = array_merge(pyhp_pkg_registry_dirs(), pyhp_pkg_remote_registries(pyhp_pkg_read_manifest($cwd)));
        fwrite(STDERR, "  searched: " . implode("\n           ", $regs ?: ['(no registry found — set one via pyhp.json "registries" or PYHP_REGISTRY)']) . "\n");
        return 1;
    }
    $got = pyhp_pkg_install_source($cwd, $name, $res);
    $lock = pyhp_lock_read($cwd);
    pyhp_lock_set($lock, $name, $got, $res['source'], $res['sha256']);
    pyhp_lock_write($cwd, $lock);
    $man = pyhp_pkg_read_manifest($cwd);
    $deps = $man['dependencies'] ?? [];
    $deps[$name] = $got;
    $man['dependencies'] = $deps;
    pyhp_pkg_write_manifest($cwd, $man);
    echo "added {$name}@{$got} -> vendor/{$name}\n";
    echo "pinned in pyhp.lock.json\n";
    echo "use it:   m = require(\"{$name}\");\n";
    return 0;
}

/** pyhp pkg install — (re)install every dependency of pyhp.json, honouring
 *  pyhp.lock.json pins (exact source + sha256) when present. */
function pyhp_pkg_install(array $args): int {
    $cwd = getcwd();
    if ($cwd === false || !is_file($cwd . '/pyhp.json')) {
        fwrite(STDERR, "pkg: no pyhp.json here — run 'pyhp pkg init' first\n");
        return 1;
    }
    $man = pyhp_pkg_read_manifest($cwd);
    $deps = $man['dependencies'] ?? [];
    if (count($deps) === 0) { echo "no dependencies to install\n"; return 0; }
    $lock = pyhp_lock_read($cwd);
    $fail = 0;
    foreach ($deps as $name => $want) {
        $vend = $cwd . '/vendor/' . $name;
        $pin = $lock['packages'][$name] ?? null;
        if (is_dir($vend . '/src') || is_file($vend . '/pyhp.json')) {
            $sha = pyhp_pkg_dir_sha($vend);
            if ($pin !== null && $pin['sha256'] === $sha) {
                echo "ok  {$name}@" . ($pin['version'] ?? '?') . " (matches lock)\n";
                continue;
            }
            if ($pin === null) {
                echo "ok  {$name}@" . (pyhp_pkg_read_manifest($vend)['version'] ?? '?') . " (unlocked)\n";
                continue;
            }
            fwrite(STDERR, "pkg: vendor/{$name} does not match pyhp.lock.json — reinstalling\n");
        }
        if ($pin !== null && preg_match('#^(https?|file)://#i', (string)$pin['source'])) {
            $err = '';
            $body = pyhp_http_get($pin['source'], $err);
            if ($body === null) { fwrite(STDERR, "pkg: {$name}: download failed: {$pin['source']} ({$err})\n"); $fail++; continue; }
            $tmp = sys_get_temp_dir() . '/pyhp-pkg-' . bin2hex(random_bytes(6)) . '.zip';
            file_put_contents($tmp, $body);
            $got = hash_file('sha256', $tmp);
            if ($got !== $pin['sha256']) {
                fwrite(STDERR, "pkg: {$name}: checksum mismatch against lock\n  expected {$pin['sha256']}\n  got      {$got}\n");
                $fail++; continue;
            }
            $ver = pyhp_pkg_install_source($cwd, $name, ['kind' => 'zip', 'file' => $tmp, 'version' => $pin['version'] ?? null]);
            echo "installed {$name}@{$ver} from lock\n";
        } else {
            $res = pyhp_pkg_resolve($name, $pin['version'] ?? (is_string($want) ? $want : null));
            if ($res === null) { fwrite(STDERR, "pkg: {$name}: not found in any registry\n"); $fail++; continue; }
            if ($pin !== null && $res['sha256'] !== $pin['sha256']) {
                fwrite(STDERR, "pkg: {$name}: registry copy does not match pyhp.lock.json\n");
                $fail++; continue;
            }
            $ver = pyhp_pkg_install_source($cwd, $name, $res);
            pyhp_lock_set($lock, $name, $ver, $res['source'], $res['sha256']);
            echo "installed {$name}@{$ver}\n";
        }
    }
    pyhp_lock_write($cwd, $lock);
    return $fail === 0 ? 0 : 1;
}

/** pyhp pkg update [name] — drop lock pins (all, or one package) and
 *  re-resolve from the registries. */
function pyhp_pkg_update(array $args): int {
    $cwd = getcwd();
    $lock = pyhp_lock_read($cwd);
    $one = $args[0] ?? null;
    if ($one !== null) {
        unset($lock['packages'][$one]);
        echo "unpinned {$one} — run 'pyhp pkg install' (or pkg add {$one}) to re-resolve\n";
    } else {
        $lock['packages'] = new stdClass();
        echo "unpinned all packages — run 'pyhp pkg install' to re-resolve\n";
    }
    pyhp_lock_write($cwd, $lock);
    return 0;
}

function pyhp_pkg_remove(array $args): int {
    if (!isset($args[0])) { fwrite(STDERR, "usage: pyhp pkg remove <name>\n"); return 1; }
    $name = $args[0];
    $cwd = getcwd();
    $man = pyhp_pkg_read_manifest($cwd);
    $deps = $man['dependencies'] ?? [];
    if (!isset($deps[$name])) {
        fwrite(STDERR, "pkg: '{$name}' is not in pyhp.json dependencies\n");
        return 1;
    }
    unset($deps[$name]);
    $man['dependencies'] = $deps;
    pyhp_pkg_write_manifest($cwd, $man);
    $lock = pyhp_lock_read($cwd);
    if (isset($lock['packages'][$name])) {
        unset($lock['packages'][$name]);
        pyhp_lock_write($cwd, $lock);
    }
    $vend = $cwd . '/vendor/' . $name;
    if (is_dir($vend)) {
        $it = new RecursiveIteratorIterator(
            new RecursiveDirectoryIterator($vend, FilesystemIterator::SKIP_DOTS),
            RecursiveIteratorIterator::CHILD_FIRST);
        foreach ($it as $item) { $item->isDir() ? rmdir($item->getPathname()) : unlink($item->getPathname()); }
        @rmdir($vend);
    }
    echo "removed {$name}\n";
    return 0;
}

function pyhp_pkg_list(): int {
    $cwd = getcwd();
    $man = pyhp_pkg_read_manifest($cwd);
    $deps = $man['dependencies'] ?? [];
    echo "project: " . ($man['name'] ?? basename($cwd)) . "@" . ($man['version'] ?? '?') . "\n";
    if (count($deps) === 0) {
        echo "dependencies: (none)\n";
    } else {
        echo "dependencies:\n";
        $lock = pyhp_lock_read($cwd);
        foreach ($deps as $n => $v) {
            $in = is_dir($cwd . '/vendor/' . $n) ? 'installed' : 'NOT installed (run: pyhp pkg install)';
            $pin = isset($lock['packages'][$n]['version']) ? ', locked ' . $lock['packages'][$n]['version'] : ', unlocked';
            echo "  {$n}@{$v}  [{$in}{$pin}]\n";
        }
    }
    $regs = pyhp_pkg_registry_dirs();
    if (count($regs) > 0) {
        echo "registry packages available:\n";
        foreach ($regs as $reg) {
            foreach (scandir($reg) ?: [] as $d) {
                if ($d[0] === '.') continue;
                $m = pyhp_pkg_read_manifest($reg . '/' . $d);
                if (isset($m['name'])) {
                    echo "  {$m['name']}@" . ($m['version'] ?? '?') . "  — " . ($m['description'] ?? '') . "\n";
                }
            }
        }
    }
    return 0;
}

function pyhp_pkg_main(array $args): int {
    $sub = $args[0] ?? 'help';
    $rest = array_slice($args, 1);
    switch ($sub) {
        case 'init':   return pyhp_pkg_init($rest);
        case 'add':    return pyhp_pkg_add($rest);
        case 'install': return pyhp_pkg_install($rest);
        case 'update': return pyhp_pkg_update($rest);
        case 'remove': case 'rm': return pyhp_pkg_remove($rest);
        case 'list':   return pyhp_pkg_list();
        default:
            echo "usage: pyhp pkg <command>\n\n";
            echo "  init            create pyhp.json + src/ stub in this folder\n";
            echo "  add <name|url>  install a package: local registry, remote registry\n";
            echo "                  (index.json), or a direct zip URL — into vendor/\n";
            echo "  install         (re)install every dependency of pyhp.json, honouring\n";
            echo "                  the pyhp.lock.json pins (exact source + sha256)\n";
            echo "  update [name]   drop lock pins so the next install re-resolves\n";
            echo "  remove <name>   uninstall a package\n";
            echo "  list            show dependencies and registry availability\n";
            return 0;
    }
}

/* ----------------------------------------------------------------- */
/* main                                                              */
/* ----------------------------------------------------------------- */

$cmd = $argv[1] ?? null;
if ($cmd === null || $cmd === 'help' || $cmd === '--help' || $cmd === '-h') {
    pyhp_usage();
    exit(0);
}
if ($cmd === 'version' || $cmd === '--version' || $cmd === '-v') {
    exit(pyhp_version_cmd(array_slice($argv, 2)));
}
if ($cmd === 'update') {
    exit(pyhp_self_update(array_slice($argv, 2)));
}
if ($cmd === 'repl') {
    exit(pyhp_repl());
}
if ($cmd === 'run') {
    // engine flags may appear anywhere after `run`; the rest are script args
    $runArgs = array_slice($argv, 2);
    $filtered = [];
    foreach ($runArgs as $a) {
        if ($a === '--tree' || $a === '--no-vm' || $a === '--vm') continue;
        $filtered[] = $a;
    }
    if (count($filtered) === 0) { fwrite(STDERR, "usage: pyhp run <script.pyh> [args...]\n"); exit(1); }
    exit(pyhp_run_file($filtered[0], array_slice($filtered, 1)));
}
if ($cmd === 'build') {
    $file = null; $out = null; $target = 'php';
    $rest = array_slice($argv, 2);
    for ($i = 0; $i < count($rest); $i++) {
        if ($rest[$i] === '-o' && isset($rest[$i + 1])) { $out = $rest[$i + 1]; $i++; }
        elseif ($rest[$i] === '--target' && isset($rest[$i + 1])) { $target = strtolower($rest[$i + 1]); $i++; }
        elseif (str_starts_with($rest[$i], '--target=')) { $target = strtolower(substr($rest[$i], 9)); }
        else { $file = $rest[$i]; }
    }
    if ($file === null || $out === null) {
        fwrite(STDERR, "usage: pyhp build <script.pyh> -o <out> [--target php|cpp|native]\n");
        exit(1);
    }
    if (!in_array($target, ['php', 'cpp', 'native'], true)) {
        fwrite(STDERR, "pyhp build: unknown target '{$target}' (php, cpp or native)\n");
        exit(1);
    }
    exit(pyhp_build_file($file, $out, $target));
}
if ($cmd === 'compile') {
    if (!isset($argv[2])) { fwrite(STDERR, "usage: pyhp compile <script.pyh> [args...]\n"); exit(1); }
    exit(pyhp_compile_run($argv[2], array_slice($argv, 3)));
}
/* ----------------------------------------------------------------- */
/* offline cross-language reference (pyhp langs)                     */
/* ----------------------------------------------------------------- */

function pyhp_langs_cmd(array $args): int {
    require_once __DIR__ . '/../src/langdata.php';
    $sel = $args[0] ?? 'compact';
    $langs = [
        'PyHP'   => 'PyHP',
        'Python' => 'Python',
        'PHP'    => 'PHP',
        'C++'    => 'C++',
        'JS'     => 'JavaScript',
    ];
    switch (strtolower($sel)) {
        case 'python': case 'py':   $show = ['PyHP', 'Python']; break;
        case 'php':                 $show = ['PyHP', 'PHP']; break;
        case 'cpp': case 'c++':     $show = ['PyHP', 'C++']; break;
        case 'js': case 'node': case 'javascript': $show = ['PyHP', 'JS']; break;
        case 'full': case 'all':    $show = array_keys($langs); break;
        case 'compact': default:    $show = ['PyHP', 'Python', 'PHP']; break;
    }
    $data = pyhp_langs_data();
    $rows = 0;
    foreach ($data as $section => $entries) {
        echo $section, "\n", str_repeat('-', 64), "\n";
        foreach ($entries as [$topic, $pyhp, $python, $php, $cpp, $js]) {
            $cells = ['PyHP' => $pyhp, 'Python' => $python, 'PHP' => $php, 'C++' => $cpp, 'JS' => $js];
            echo '  ', $topic, "\n";
            foreach ($show as $l) {
                echo '      ', str_pad($langs[$l] . ':', 12), $cells[$l], "\n";
            }
            $rows++;
        }
        echo "\n";
    }
    echo $rows, " entries — PyHP needs only PHP to run; use `pyhp langs full` for C++/JavaScript\n";
    return 0;
}

if (
$cmd === 'langs') {
    exit(pyhp_langs_cmd(array_slice($argv, 2)));
}
if ($cmd === 'pkg') {
    exit(pyhp_pkg_main(array_slice($argv, 2)));
}
fwrite(STDERR, "unknown command '{$cmd}'\n\n");
pyhp_usage();
exit(1);
